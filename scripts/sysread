#!/usr/bin/env bash
# sysread - one-shot / streaming hardware sensor collector.
# Reads /proc, /sys/class/hwmon (+ drm for Intel) and nvidia-smi (if present).
# Emits one JSON object per line, schema version 2. See SPEC section 2.
#
# Cheap by design: sensor files are found once at startup (and again every
# RESCAN_EVERY readings, for hotplug) and read with shell builtins, so a
# reading forks nothing but `stat` for disk space and one `nvidia-smi` call
# on NVIDIA. MONITOR_READ names what to read; anything it leaves out reads
# as null (or []), so a switched-off piece costs nothing.
# `sysread --info` prints the facts that never change (model names,
# sizes, drivers) once, as one JSON object for the menu.
set -u

HWMON_ROOT="${MONITOR_HWMON_ROOT:-/sys/class/hwmon}"
DRM_ROOT="${MONITOR_DRM_ROOT:-/sys/class/drm}"
NET_DEV_FILE="${MONITOR_NET_DEV_FILE:-/proc/net/dev}"
ROOT_MOUNT="${MONITOR_ROOT_MOUNT:-/}"
DISKSTATS_PATH="${MONITOR_DISKSTATS_PATH:-/proc/diskstats}"
MOUNTS_FILE="${MONITOR_MOUNTS_FILE:-/proc/mounts}"
# Choices the widget passes down from its prefs. "auto", or a source or an
# interface this machine does not have, keeps the automatic pick; a mount
# that cannot be read falls back to "/".
GPU_WANTED="${MONITOR_GPU:-auto}"
NET_IFACE_WANTED="${MONITOR_NET_IFACE:-auto}"
# What to read, as a comma list of: cpu, temp, clocks, load, mem, gpu, net,
# disk, io, fans, mounts. "all" (the default) reads everything, "none"
# nothing. A GPU source is probed only while "gpu" is read: nvidia-smi
# wakes a sleeping NVIDIA card.
READ_LIST=",${MONITOR_READ:-all},"
RESCAN_EVERY=30
# A fake filesystem root for every path `--info` reads (tests).
INFO_ROOT="${MONITOR_INFO_ROOT:-}"

# ---------------------------------------------------------------------------
# Persistent state (priming / once-only detection / sensor caches)
# ---------------------------------------------------------------------------
CPU_PREV_IDLE=""
CPU_PREV_TOTAL=""
GPU_SOURCE="undecided" # nvidia | amd | intel | none
GPU_SOURCES_JSON="[]"  # every source that answered at startup
CPU_INFO_DONE=0
INTEL_PREV_BUSY=""
INTEL_PREV_TIME_NS=""
NET_IFACE_DECIDED=0
NET_IFACE=""
NET_IFACES_JSON="[]"
NET_PREV_RX=""
NET_PREV_TX=""
NET_PREV_TIME_US=""
DISK_PREV_READ=""
DISK_PREV_WRITE=""
DISK_PREV_TIME_US=""
READINGS=0
NOW_US=0
TICK=""           # fd of the pipe `pause` waits on

# Sensor files, found by scan_sensors / scan_intel_engines.
TEMP_PACKAGE=()   # temp*_input of the CPU package (Tctl/Tdie, Package id)
TEMP_OTHER=()     # every other temp*_input, the fallback
FAN_INPUTS=()     # fan*_input files, sorted by fan id
FAN_JSON_HEAD=()  # the JSON of each fan up to its rpm value
AMD_DIRS=()       # hwmon dirs of amdgpu chips
BUSY_FILES=()     # gpu_busy_percent files, any chip
FREQ_FILES=()     # cpufreq scaling_cur_freq files
INTEL_ENGINES=()  # drm busy_time files

# Per-reading values (JSON fragments: number or the literal "null", except
# fans/load/detail/model which hold ready-made JSON snippets).
reset_reading() {
  VAL_CPU="null"
  VAL_TEMP="null"
  VAL_MEM="null"
  VAL_GPU="null"
  VAL_GPU_TEMP="null"
  FANS_JSON="[]"
  VAL_CPU_MHZ="null"
  VAL_GPU_MHZ="null"
  VAL_MEM_USED="null"
  VAL_MEM_TOTAL="null"
  VAL_SWAP_USED="null"
  VAL_SWAP_TOTAL="null"
  LOAD_JSON="null"
  GPU_DETAIL_JSON="null"
  VAL_NET_DOWN="null"
  VAL_NET_UP="null"
  NET_JSON="null"
  VAL_DISK_USED_PCT="null"
  VAL_DISK_USED_B="null"
  VAL_DISK_TOTAL_B="null"
  DISK_MOUNT="$ROOT_MOUNT"
  DISK_MOUNTS_JSON="[]"
  VAL_DISK_READ="null"
  VAL_DISK_WRITE="null"
  DISK_JSON="null"
  NVIDIA_VRAM_USED_B="null"
  NVIDIA_VRAM_TOTAL_B="null"
  NVIDIA_WATTS="null"
  AMD_VRAM_USED_B="null"
  AMD_VRAM_TOTAL_B="null"
  AMD_WATTS="null"
}
reset_reading
VAL_CPU_MODEL_JSON="null"
VAL_CPU_CORES="null"

# ---------------------------------------------------------------------------
# Small helpers. Each writes into a variable the caller names, so none of
# them costs a subshell.
# ---------------------------------------------------------------------------

# wants <name>: succeeds when MONITOR_READ asks for <name>.
wants() {
  [[ "$READ_LIST" == *",all,"* || "$READ_LIST" == *",$1,"* ]]
}

# trim_to <var> <string>: <var> = <string> without surrounding whitespace.
trim_to() {
  local __trim="${2:-}"
  __trim="${__trim#"${__trim%%[![:space:]]*}"}"
  __trim="${__trim%"${__trim##*[![:space:]]}"}"
  printf -v "$1" '%s' "$__trim"
}

# quote_to <var> <string>: <var> = <string> as a JSON string literal.
quote_to() {
  local __q="${2:-}"
  __q=${__q//\\/\\\\}
  __q=${__q//\"/\\\"}
  __q=${__q//$'\t'/\\t}
  __q=${__q//$'\n'/\\n}
  __q=${__q//$'\r'/\\r}
  __q=${__q//$'\b'/\\b}
  __q=${__q//$'\f'/\\f}
  printf -v "$1" '"%s"' "$__q"
}

# cpu_model_clean_to <var> <model name>: the name without trademark marks,
# base clock and filler words, so "Intel(R) Core(TM) i7-8550U CPU @
# 1.80GHz" reads "Intel Core i7-8550U" and "AMD Ryzen 7 5800X 8-Core
# Processor" reads "AMD Ryzen 7 5800X".
cpu_model_clean_to() {
  local __raw="${2:-}" __word __out=""
  local -a __words=()
  __raw="${__raw%%@*}"
  __raw="${__raw//(R)/}"
  __raw="${__raw//(r)/}"
  __raw="${__raw//(TM)/}"
  __raw="${__raw//(tm)/}"
  read -r -a __words <<< "$__raw"
  for __word in "${__words[@]}"; do
    case "$__word" in
      CPU|Processor|*-Core|*-core) continue ;;
    esac
    __out+="${__out:+ }$__word"
  done
  printf -v "$1" '%s' "$__out"
}

# read_to <var> <file>: <var> = the file's first line, trimmed; fails when
# the file cannot be read.
read_to() {
  local __line=""
  { IFS= read -r __line || [[ -n "$__line" ]]; } 2>/dev/null < "$2" || return 1
  trim_to "$1" "$__line"
}

# lines_to <array> <file>: every line of a /proc file, in one sequential
# read. `while read` seeks back after each line and /proc rebuilds the
# text on a seek, so a line that changed length (cpu MHz) shifts the rest:
# one line is lost or read twice.
lines_to() {
  [[ -r "$2" ]] || return 1
  mapfile -t "$1" 2>/dev/null < "$2"
}

# One /proc/net/dev line: name, rx bytes, seven more rx counters, tx bytes.
NET_LINE_RE='^[[:space:]]*([^[:space:]:]+):[[:space:]]*([0-9]+)([[:space:]]+[0-9]+){7}[[:space:]]+([0-9]+)'
# One /proc/diskstats line: major, minor, name, reads, merged, sectors
# read, then ms, writes and merged, then sectors written.
DISK_LINE_RE='^[[:space:]]*[0-9]+[[:space:]]+[0-9]+[[:space:]]+([^[:space:]]+)[[:space:]]+[0-9]+[[:space:]]+[0-9]+[[:space:]]+([0-9]+)([[:space:]]+[0-9]+){3}[[:space:]]+([0-9]+)'

# is_uint <string>: succeeds if the string is a non-negative integer.
is_uint() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

# is_number <string>: succeeds for JSON-style decimal numbers.
is_number() {
  case "${1:-}" in
    ''|*[!0-9.eE+-]*) return 1 ;;
  esac
  [[ "${1:-}" =~ ^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$ ]]
}

# now_us: microseconds since the epoch into NOW_US, from bash's own clock.
now_us() {
  if [[ -n "${EPOCHREALTIME:-}" ]]; then
    local t="${EPOCHREALTIME/[.,]/}"
    NOW_US=$((10#$t))
  else
    NOW_US=$(($(date +%s%N) / 1000))
  fi
}

# ---------------------------------------------------------------------------
# Sensor discovery (at startup, then every RESCAN_EVERY readings)
# ---------------------------------------------------------------------------

# scan_sensors: find every hwmon temp and fan input, the amdgpu chips and
# the cpufreq files. Labels and chip names cannot change, so they are read
# here once instead of on every reading.
scan_sensors() {
  TEMP_PACKAGE=()
  TEMP_OTHER=()
  FAN_INPUTS=()
  FAN_JSON_HEAD=()
  AMD_DIRS=()
  BUSY_FILES=()
  FREQ_FILES=()
  local dir chip chip_lc input label base fan_name fnum pref
  local -a fans=()
  for dir in "$HWMON_ROOT"/*; do
    [[ -d "$dir" ]] || continue
    chip=""
    read_to chip "$dir/name" || true
    [[ -n "$chip" ]] || chip="${dir##*/}"
    chip_lc="${chip,,}"
    if [[ "$chip_lc" == *amdgpu* ]]; then
      AMD_DIRS+=("$dir")
    fi
    if [[ -f "$dir/gpu_busy_percent" && -r "$dir/gpu_busy_percent" ]]; then
      BUSY_FILES+=("$dir/gpu_busy_percent")
    fi
    for input in "$dir"/temp*_input; do
      [[ -f "$input" ]] || continue
      label=""
      read_to label "${input%_input}_label" || true
      pref=0
      if [[ "$chip_lc" == "k10temp" || "$chip_lc" == "zenpower" ]]; then
        if [[ "$label" == "Tctl" || "$label" == "Tdie" ]]; then
          pref=1
        fi
      elif [[ "$chip_lc" == "coretemp" && "$label" == *"Package id"* ]]; then
        pref=1
      fi
      if [[ "$pref" -eq 1 ]]; then
        TEMP_PACKAGE+=("$input")
      else
        TEMP_OTHER+=("$input")
      fi
    done
    for input in "$dir"/fan*_input; do
      [[ -f "$input" ]] || continue
      base="${input##*/}"         # e.g. fan1_input
      fan_name="${base%_input}"   # e.g. fan1
      fnum="${fan_name#fan}"
      label=""
      read_to label "$dir/${fan_name}_label" || true
      if [[ -z "$label" ]]; then
        if is_uint "$fnum"; then
          label="Fan $fnum"
        else
          label="Fan $fan_name"
        fi
      fi
      fans+=("$chip/$fan_name|$chip|$label|$input")
    done
  done
  # Fans in a stable order: sorted by id, once per scan.
  if [[ "${#fans[@]}" -gt 0 ]]; then
    local id fchip flabel finput jid jchip jlabel
    while IFS='|' read -r id fchip flabel finput; do
      [[ -n "$id" ]] || continue
      quote_to jid "$id"
      quote_to jchip "$fchip"
      quote_to jlabel "$flabel"
      FAN_INPUTS+=("$finput")
      FAN_JSON_HEAD+=("{\"id\":$jid,\"chip\":$jchip,\"label\":$jlabel,\"rpm\":")
    done < <(printf '%s\n' "${fans[@]}" | LC_ALL=C sort)
  fi
  local f
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
    if [[ -r "$f" ]]; then
      FREQ_FILES+=("$f")
    fi
  done
}

# scan_intel_engines: Intel drm busy_time engines, also nested deeper.
scan_intel_engines() {
  INTEL_ENGINES=()
  local b
  for b in "$DRM_ROOT"/card*/engine/*/busy_time "$DRM_ROOT"/card*/gt*/busy_time; do
    if [[ -f "$b" && -r "$b" ]]; then
      INTEL_ENGINES+=("$b")
    fi
  done
  if [[ "${#INTEL_ENGINES[@]}" -eq 0 && -d "$DRM_ROOT" ]]; then
    while IFS= read -r b; do
      if [[ -n "$b" && -r "$b" ]]; then
        INTEL_ENGINES+=("$b")
      fi
    done < <(find "$DRM_ROOT" -name busy_time 2>/dev/null | LC_ALL=C sort || true)
  fi
}

# ---------------------------------------------------------------------------
# provider: cpu_info (cpu_model / cpu_cores, detected once)
# ---------------------------------------------------------------------------
provider_cpu_info_once() {
  if [[ "$CPU_INFO_DONE" -eq 1 ]]; then
    return 0
  fi
  CPU_INFO_DONE=1
  local -a lines=()
  local line model="" cores=0
  lines_to lines /proc/cpuinfo || true
  for line in "${lines[@]}"; do
    case "$line" in
      processor[[:space:]]*:*) cores=$((cores + 1)) ;;
      "model name"*:*)
        if [[ -z "$model" ]]; then
          cpu_model_clean_to model "${line#*:}"
        fi
        ;;
    esac
  done
  if [[ -n "$model" ]]; then
    quote_to VAL_CPU_MODEL_JSON "$model"
  fi
  if [[ "$cores" -gt 0 ]]; then
    VAL_CPU_CORES="$cores"
  fi
}

# ---------------------------------------------------------------------------
# provider: cpu (percentage via /proc/stat delta; first call primes -> null)
# ---------------------------------------------------------------------------
provider_cpu_usage() {
  VAL_CPU="null"
  local label user nice system idle iowait irq softirq steal v
  { read -r label user nice system idle iowait irq softirq steal _; } 2>/dev/null < /proc/stat || return 0
  [[ "$label" == "cpu" ]] || return 0
  for v in "$user" "$nice" "$system" "$idle" "$iowait" "$irq" "$softirq" "$steal"; do
    is_uint "$v" || return 0
  done
  local cur_idle=$((idle + iowait))
  local cur_total=$((user + nice + system + idle + iowait + irq + softirq + steal))
  if [[ -z "$CPU_PREV_IDLE" || -z "$CPU_PREV_TOTAL" ]]; then
    CPU_PREV_IDLE="$cur_idle"
    CPU_PREV_TOTAL="$cur_total"
    return 0
  fi
  local d_idle=$((cur_idle - CPU_PREV_IDLE))
  local d_total=$((cur_total - CPU_PREV_TOTAL))
  CPU_PREV_IDLE="$cur_idle"
  CPU_PREV_TOTAL="$cur_total"
  [[ "$d_total" -gt 0 ]] || return 0
  local busy=$((d_total - d_idle))
  if [[ "$busy" -lt 0 ]]; then
    busy=0
  fi
  local pct=$(((busy * 100 + d_total / 2) / d_total))
  if [[ "$pct" -gt 100 ]]; then pct=100; fi
  VAL_CPU="$pct"
}

# ---------------------------------------------------------------------------
# provider: memory (percentage + KiB counters from /proc/meminfo)
# ---------------------------------------------------------------------------
provider_memory() {
  local -a lines=()
  lines_to lines /proc/meminfo || return 0
  local line mem_total="" mem_avail="" swap_total="" swap_free=""
  for line in "${lines[@]}"; do
    [[ "$line" =~ ^(MemTotal|MemAvailable|SwapTotal|SwapFree):[[:space:]]+([0-9]+) ]] || continue
    case "${BASH_REMATCH[1]}" in
      MemTotal) mem_total="${BASH_REMATCH[2]}" ;;
      MemAvailable) mem_avail="${BASH_REMATCH[2]}" ;;
      SwapTotal) swap_total="${BASH_REMATCH[2]}" ;;
      SwapFree) swap_free="${BASH_REMATCH[2]}"; break ;;
    esac
  done
  if is_uint "$mem_total" && is_uint "$mem_avail"; then
    VAL_MEM_TOTAL="$mem_total"
    local used=$((mem_total - mem_avail))
    if [[ "$used" -lt 0 ]]; then used=0; fi
    VAL_MEM_USED="$used"
    if [[ "$mem_total" -gt 0 ]]; then
      VAL_MEM="$(((used * 100 + mem_total / 2) / mem_total))"
    fi
  fi
  if is_uint "$swap_total"; then
    VAL_SWAP_TOTAL="$swap_total"
    if is_uint "$swap_free"; then
      local s_used=$((swap_total - swap_free))
      if [[ "$s_used" -lt 0 ]]; then s_used=0; fi
      VAL_SWAP_USED="$s_used"
    else
      VAL_SWAP_USED="$swap_total"
    fi
  fi
}

# ---------------------------------------------------------------------------
# provider: hwmon temperature (package preference, sane-range fallback)
# ---------------------------------------------------------------------------
# hottest_to <var> <input>...: <var> = the hottest reading in the sane
# range (0, 150) °C, or empty.
hottest_to() {
  local __var="$1" __best="" __input __raw __c
  shift
  for __input in "$@"; do
    read_to __raw "$__input" || continue
    [[ "$__raw" =~ ^-?[0-9]+$ ]] || continue
    __c=$((__raw / 1000))
    if [[ "$__c" -gt 0 && "$__c" -lt 150 && ( -z "$__best" || "$__c" -gt "$__best" ) ]]; then
      __best="$__c"
    fi
  done
  printf -v "$__var" '%s' "$__best"
}

# The package sensor alone when it answers: most machines expose dozens
# of temp inputs, and some (wifi, ACPI zones) are slow to read.
provider_hwmon_temp() {
  local best=""
  hottest_to best "${TEMP_PACKAGE[@]}"
  if [[ -z "$best" ]]; then
    hottest_to best "${TEMP_OTHER[@]}"
  fi
  if [[ -n "$best" ]]; then
    VAL_TEMP="$best"
  fi
}

# ---------------------------------------------------------------------------
# provider: fans (every readable fan as {id,chip,label,rpm})
# ---------------------------------------------------------------------------
provider_fans() {
  local json="" i raw
  for i in "${!FAN_INPUTS[@]}"; do
    read_to raw "${FAN_INPUTS[$i]}" || continue
    is_uint "$raw" || continue
    json+="${json:+,}${FAN_JSON_HEAD[$i]}$raw}"
  done
  FANS_JSON="[$json]"
}

# ---------------------------------------------------------------------------
# GPU source selection (once at startup)
# ---------------------------------------------------------------------------

# nvidia-smi present and answering: a numeric utilization on the first line.
gpu_probe_nvidia() {
  command -v nvidia-smi >/dev/null 2>&1 || return 1
  local probe=""
  IFS= read -r probe < <(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null) || true
  trim_to probe "$probe"
  [[ "$probe" =~ ^[0-9]+ ]]
}

# amdgpu gpu_busy_percent anywhere under the hwmon root.
gpu_probe_amd() {
  [[ "${#BUSY_FILES[@]}" -gt 0 ]]
}

# Intel drm busy_time engines.
gpu_probe_intel() {
  [[ "${#INTEL_ENGINES[@]}" -gt 0 ]]
}

# pick_gpu_source: probe every source once, then read the one the widget
# asked for (MONITOR_GPU) when it answers, else the first that answers in
# this order: nvidia, amd, intel. The answering list goes to the menu.
pick_gpu_source() {
  if [[ "$GPU_SOURCE" != "undecided" ]]; then
    return 0
  fi
  local sources="" list="" s
  for s in nvidia amd intel; do
    if "gpu_probe_$s"; then
      sources+="${sources:+ }$s"
      list+="${list:+,}\"$s\""
    fi
  done
  GPU_SOURCES_JSON="[$list]"
  GPU_SOURCE="none"
  for s in $sources; do
    if [[ "$s" == "$GPU_WANTED" ]]; then
      GPU_SOURCE="$s"
      return 0
    fi
  done
  for s in $sources; do
    GPU_SOURCE="$s"
    return 0
  done
}

# ---------------------------------------------------------------------------
# provider: gpu-nvidia (ONE nvidia-smi call per reading, shared fields)
# ---------------------------------------------------------------------------
provider_gpu_nvidia() {
  local out=""
  IFS= read -r out < <(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,clocks.sm,memory.used,memory.total,power.draw --format=csv,noheader,nounits 2>/dev/null) || true
  trim_to out "$out"
  [[ -n "$out" ]] || return 0
  local util temp clock mem_used mem_total power
  IFS=',' read -r util temp clock mem_used mem_total power <<< "$out"
  trim_to util "${util:-}"
  trim_to temp "${temp:-}"
  trim_to clock "${clock:-}"
  trim_to mem_used "${mem_used:-}"
  trim_to mem_total "${mem_total:-}"
  trim_to power "${power:-}"
  # utilization may arrive as "23" (single field query) or "23 %" etc; take leading int
  if [[ "$util" =~ ^([0-9]+) ]]; then
    VAL_GPU="${BASH_REMATCH[1]}"
  fi
  if [[ "$temp" =~ ^([0-9]+) ]]; then
    VAL_GPU_TEMP="${BASH_REMATCH[1]}"
  fi
  if [[ "$clock" =~ ^([0-9]+) ]]; then
    VAL_GPU_MHZ="${BASH_REMATCH[1]}"
  fi
  if [[ "$mem_used" =~ ^([0-9]+) ]]; then
    NVIDIA_VRAM_USED_B="$((BASH_REMATCH[1] * 1048576))"
  fi
  if [[ "$mem_total" =~ ^([0-9]+) ]]; then
    NVIDIA_VRAM_TOTAL_B="$((BASH_REMATCH[1] * 1048576))"
  fi
  # power like "45.00" or "[N/A]"
  if is_number "$power"; then
    NVIDIA_WATTS="$power"
  elif [[ "$power" =~ ^([0-9]*\.?[0-9]+) ]]; then
    NVIDIA_WATTS="${BASH_REMATCH[1]}"
  fi
}

# ---------------------------------------------------------------------------
# provider: gpu-amd (gpu_busy_percent + amdgpu sysfs VRAM/power/clocks/temp)
# ---------------------------------------------------------------------------

# amd_mhz_to <var> <file>: the file's Hz reading as MHz, if positive.
amd_mhz_to() {
  local __hz=""
  read_to __hz "$2" || return 1
  is_uint "$__hz" || return 1
  [[ $((__hz / 1000000)) -gt 0 ]] || return 1
  printf -v "$1" '%s' "$((__hz / 1000000))"
}

provider_gpu_amd() {
  local f raw d input m best="" mhz=""
  # utilization: the first numeric gpu_busy_percent (scan order is sorted)
  for f in "${BUSY_FILES[@]}"; do
    read_to raw "$f" || continue
    if [[ "$raw" =~ ^([0-9]+) ]]; then
      VAL_GPU="${BASH_REMATCH[1]}"
      break
    fi
  done
  # gpu temp: hottest sane temp among amdgpu chips
  local -a temps=()
  for d in "${AMD_DIRS[@]}"; do
    temps+=("$d"/temp*_input)
  done
  hottest_to best "${temps[@]}"
  if [[ -n "$best" ]]; then
    VAL_GPU_TEMP="$best"
  fi
  # gpu clock: prefer freq1_input (sclk), else the highest freq*_input
  for d in "${AMD_DIRS[@]}"; do
    if amd_mhz_to m "$d/freq1_input" && [[ -z "$mhz" || "$m" -gt "$mhz" ]]; then
      mhz="$m"
    fi
  done
  if [[ -z "$mhz" ]]; then
    for d in "${AMD_DIRS[@]}"; do
      for input in "$d"/freq*_input; do
        if amd_mhz_to m "$input" && [[ -z "$mhz" || "$m" -gt "$mhz" ]]; then
          mhz="$m"
        fi
      done
    done
  fi
  if [[ -n "$mhz" ]]; then
    VAL_GPU_MHZ="$mhz"
  fi
  # VRAM used/total (bytes already) + power (microwatts -> watts)
  for d in "${AMD_DIRS[@]}"; do
    if [[ "$AMD_VRAM_USED_B" == "null" ]] && read_to raw "$d/mem_info_vram_used" && is_uint "$raw"; then
      AMD_VRAM_USED_B="$raw"
    fi
    if [[ "$AMD_VRAM_TOTAL_B" == "null" ]] && read_to raw "$d/mem_info_vram_total" && is_uint "$raw"; then
      AMD_VRAM_TOTAL_B="$raw"
    fi
    if [[ "$AMD_WATTS" == "null" ]]; then
      local pfile=""
      if [[ -f "$d/power1_input" ]]; then
        pfile="$d/power1_input"
      else
        for input in "$d"/power*_input; do
          if [[ -e "$input" ]]; then
            pfile="$input"
            break
          fi
        done
      fi
      if [[ -n "$pfile" ]] && read_to raw "$pfile" && is_uint "$raw"; then
        local tenths=$(((raw + 50000) / 100000))
        AMD_WATTS="$((tenths / 10)).$((tenths % 10))"
      fi
    fi
  done
}

# ---------------------------------------------------------------------------
# provider: gpu-intel (summed drm busy_time deltas; primes -> null)
# ---------------------------------------------------------------------------
provider_gpu_intel() {
  [[ "${#INTEL_ENGINES[@]}" -gt 0 ]] || return 0
  local total=0 f raw
  for f in "${INTEL_ENGINES[@]}"; do
    if read_to raw "$f" && is_uint "$raw"; then
      total=$((total + raw))
    fi
  done
  now_us
  local now_ns=$((NOW_US * 1000))
  if [[ -z "$INTEL_PREV_BUSY" || -z "$INTEL_PREV_TIME_NS" ]]; then
    INTEL_PREV_BUSY="$total"
    INTEL_PREV_TIME_NS="$now_ns"
    return 0
  fi
  local d_busy=$((total - INTEL_PREV_BUSY))
  local d_time=$((now_ns - INTEL_PREV_TIME_NS))
  INTEL_PREV_BUSY="$total"
  INTEL_PREV_TIME_NS="$now_ns"
  # a counter wrap or a changed engine set re-primes
  [[ "$d_time" -gt 0 && "$d_busy" -ge 0 ]] || return 0
  # busy_time is in nanoseconds; utilization over wall * engine count
  local span=$((d_time * ${#INTEL_ENGINES[@]}))
  local pct=$(((d_busy * 100 + span / 2) / span))
  if [[ "$pct" -gt 100 ]]; then pct=100; fi
  VAL_GPU="$pct"
}

# dispatch to whichever GPU source was picked once at startup
provider_gpu() {
  case "$GPU_SOURCE" in
    nvidia) provider_gpu_nvidia ;;
    amd) provider_gpu_amd ;;
    intel) provider_gpu_intel ;;
  esac
}

# ---------------------------------------------------------------------------
# provider: clocks (mean CPU clock in MHz; GPU clock comes from GPU providers)
# ---------------------------------------------------------------------------
provider_clocks() {
  local sum=0 count=0 f raw
  for f in "${FREQ_FILES[@]}"; do
    if read_to raw "$f" && is_uint "$raw" && [[ "$raw" -gt 0 ]]; then
      sum=$((sum + raw))
      count=$((count + 1))
    fi
  done
  if [[ "$count" -gt 0 ]]; then
    # cpufreq reports kHz: rounded mean MHz
    local mhz=$(((sum + count * 500) / count / 1000))
    if [[ "$mhz" -gt 0 ]]; then
      VAL_CPU_MHZ="$mhz"
    fi
    return 0
  fi
  # no cpufreq: the mean "cpu MHz" of /proc/cpuinfo
  local -a lines=()
  lines_to lines /proc/cpuinfo || return 0
  local line value
  for line in "${lines[@]}"; do
    [[ "$line" == "cpu MHz"*:* ]] || continue
    trim_to value "${line#*:}"
    value="${value%%.*}"
    if is_uint "$value"; then
      sum=$((sum + value))
      count=$((count + 1))
    fi
  done
  if [[ "$count" -gt 0 ]]; then
    VAL_CPU_MHZ="$(((sum + count / 2) / count))"
  fi
}

# ---------------------------------------------------------------------------
# provider: load (from /proc/loadavg)
# ---------------------------------------------------------------------------
provider_load() {
  local one five fifteen
  { read -r one five fifteen _; } 2>/dev/null < /proc/loadavg || return 0
  if is_number "$one" && is_number "$five" && is_number "$fifteen"; then
    LOAD_JSON="{\"one\":$one,\"five\":$five,\"fifteen\":$fifteen}"
  fi
}

# ---------------------------------------------------------------------------
# provider: network (one interface, picked once; rate via wall-clock delta)
# ---------------------------------------------------------------------------

# is_real_iface <name>: excludes loopback and common virtual interfaces so
# the "busiest interface" guess doesn't land on a container/VPN veth pair.
is_real_iface() {
  case "$1" in
    lo|docker*|veth*|br-*|virbr*|tun*|tap*|wg*) return 1 ;;
    *) return 0 ;;
  esac
}

# pick_net_iface: read the interface the widget asked for when it exists,
# else the non-virtual one with the most combined rx+tx bytes at startup,
# the same one-shot decision as pick_gpu_source. /proc/net/dev splits on
# the colon after the name, which can touch the first counter.
pick_net_iface() {
  NET_IFACE_DECIDED=1
  NET_IFACE=""
  local -a lines=()
  lines_to lines "$NET_DEV_FILE" || return 0
  local best="" best_total=-1 wanted=0 line name rx tx
  for line in "${lines[@]}"; do
    [[ "$line" =~ $NET_LINE_RE ]] || continue
    name="${BASH_REMATCH[1]}"
    rx="${BASH_REMATCH[2]}"
    tx="${BASH_REMATCH[4]}"
    if [[ "$name" == "$NET_IFACE_WANTED" ]]; then
      wanted=1
    fi
    is_real_iface "$name" || continue
    if [[ $((rx + tx)) -gt "$best_total" ]]; then
      best_total=$((rx + tx))
      best="$name"
    fi
  done
  if [[ "$wanted" -eq 1 ]]; then
    NET_IFACE="$NET_IFACE_WANTED"
  else
    NET_IFACE="$best"
  fi
}

provider_net() {
  if [[ "$NET_IFACE_DECIDED" -eq 0 ]]; then
    pick_net_iface
  fi
  [[ -n "$NET_IFACE" ]] || return 0
  local -a lines=()
  lines_to lines "$NET_DEV_FILE" || return 0
  # One pass: the counters of the chosen interface, and every interface
  # the menu can offer (the real ones, plus the chosen one if virtual).
  local line name cur_rx="" cur_tx="" list="" quoted
  for line in "${lines[@]}"; do
    [[ "$line" =~ $NET_LINE_RE ]] || continue
    name="${BASH_REMATCH[1]}"
    if [[ "$name" == "$NET_IFACE" ]]; then
      cur_rx="${BASH_REMATCH[2]}"
      cur_tx="${BASH_REMATCH[4]}"
    fi
    if is_real_iface "$name" || [[ "$name" == "$NET_IFACE" ]]; then
      quote_to quoted "$name"
      list+="${list:+,}$quoted"
    fi
  done
  NET_IFACES_JSON="[$list]"
  [[ -n "$cur_rx" ]] || return 0
  now_us
  if [[ -z "$NET_PREV_RX" || -z "$NET_PREV_TX" || -z "$NET_PREV_TIME_US" ]]; then
    NET_PREV_RX="$cur_rx"
    NET_PREV_TX="$cur_tx"
    NET_PREV_TIME_US="$NOW_US"
    return 0
  fi
  local d_rx=$((cur_rx - NET_PREV_RX))
  local d_tx=$((cur_tx - NET_PREV_TX))
  local d_time=$((NOW_US - NET_PREV_TIME_US))
  NET_PREV_RX="$cur_rx"
  NET_PREV_TX="$cur_tx"
  NET_PREV_TIME_US="$NOW_US"
  if [[ "$d_time" -le 0 || "$d_rx" -lt 0 || "$d_tx" -lt 0 ]]; then
    return 0
  fi
  VAL_NET_DOWN=$((d_rx * 1000000 / d_time))
  VAL_NET_UP=$((d_tx * 1000000 / d_time))
}

assemble_net() {
  if [[ -z "$NET_IFACE" ]]; then
    return 0
  fi
  local iface
  quote_to iface "$NET_IFACE"
  NET_JSON="{\"iface\":$iface,\"ifaces\":$NET_IFACES_JSON,\"down_bps\":$VAL_NET_DOWN,\"up_bps\":$VAL_NET_UP}"
}

# ---------------------------------------------------------------------------
# provider: disk (usage % of ROOT_MOUNT via stat -f; I/O via /proc/diskstats)
# ---------------------------------------------------------------------------

# is_whole_disk <device name>: real block devices only, no partitions,
# loop devices or device-mapper nodes, so I/O isn't double-counted.
is_whole_disk() {
  case "$1" in
    sd[a-z]|sd[a-z][a-z]) return 0 ;;
    vd[a-z]) return 0 ;;
    hd[a-z]) return 0 ;;
    nvme[0-9]*n[0-9]*)
      case "$1" in *p[0-9]*) return 1 ;; esac
      return 0 ;;
    mmcblk[0-9]*)
      case "$1" in *p[0-9]*) return 1 ;; esac
      return 0 ;;
    *) return 1 ;;
  esac
}

# Disk usage has no /proc or /sys equivalent to statvfs(2) — stat(1) is the
# thinnest wrapper around it, and the one process a disk reading forks.
# disk_stat_to <var> <path>: "blocks avail block_size", or a failure.
disk_stat_to() {
  local __out=""
  __out="$(stat -f -c '%b %a %S' "$2" 2>/dev/null)" || return 1
  [[ -n "$__out" ]] || return 1
  printf -v "$1" '%s' "$__out"
}

provider_disk_usage() {
  local out=""
  if ! disk_stat_to out "$DISK_MOUNT"; then
    # A mount the widget asked for can be gone (an unplugged drive).
    DISK_MOUNT="/"
    disk_stat_to out "/" || return 0
  fi
  local blocks avail size
  read -r blocks avail size <<< "$out"
  is_uint "$blocks" || return 0
  is_uint "$avail" || return 0
  [[ "$blocks" -gt 0 ]] || return 0
  local used=$((blocks - avail))
  if [[ "$used" -lt 0 ]]; then
    used=0
  fi
  VAL_DISK_USED_PCT="$(((used * 100 + blocks / 2) / blocks))"
  if is_uint "$size"; then
    VAL_DISK_USED_B="$((used * size))"
    VAL_DISK_TOTAL_B="$((blocks * size))"
  fi
}

provider_disk_io() {
  local -a lines=()
  lines_to lines "$DISKSTATS_PATH" || return 0
  local total_read=0 total_write=0 line
  for line in "${lines[@]}"; do
    [[ "$line" =~ $DISK_LINE_RE ]] || continue
    is_whole_disk "${BASH_REMATCH[1]}" || continue
    total_read=$((total_read + BASH_REMATCH[2]))
    total_write=$((total_write + BASH_REMATCH[4]))
  done
  now_us
  local cur_read=$((total_read * 512))
  local cur_write=$((total_write * 512))
  if [[ -z "$DISK_PREV_READ" || -z "$DISK_PREV_WRITE" || -z "$DISK_PREV_TIME_US" ]]; then
    DISK_PREV_READ="$cur_read"
    DISK_PREV_WRITE="$cur_write"
    DISK_PREV_TIME_US="$NOW_US"
    return 0
  fi
  local d_read=$((cur_read - DISK_PREV_READ))
  local d_write=$((cur_write - DISK_PREV_WRITE))
  local d_time=$((NOW_US - DISK_PREV_TIME_US))
  DISK_PREV_READ="$cur_read"
  DISK_PREV_WRITE="$cur_write"
  DISK_PREV_TIME_US="$NOW_US"
  if [[ "$d_time" -le 0 || "$d_read" -lt 0 || "$d_write" -lt 0 ]]; then
    return 0
  fi
  VAL_DISK_READ=$((d_read * 1000000 / d_time))
  VAL_DISK_WRITE=$((d_write * 1000000 / d_time))
}

# real_mounts_scan <mounts file>: the real filesystems, one mount point
# per device, so btrfs subvolumes don't list one disk thrice. Fills
# MOUNT_DEVS, MOUNT_POINTS and MOUNT_TYPES in file order.
real_mounts_scan() {
  MOUNT_DEVS=()
  MOUNT_POINTS=()
  MOUNT_TYPES=()
  local -a lines=()
  local seen=" " line dev mp
  lines_to lines "$1" || return 0
  for line in "${lines[@]}"; do
    # device, mount point, type; /proc/mounts escapes a space as \040.
    [[ "$line" =~ ^([^ ]+)\ ([^ ]+)\ ([^ ]+)\  ]] || continue
    case "${BASH_REMATCH[3]}" in
      ext2|ext3|ext4|btrfs|xfs|vfat|exfat|ntfs|ntfs3|f2fs|zfs|bcachefs|jfs|fuseblk) ;;
      *) continue ;;
    esac
    dev="${BASH_REMATCH[1]}"
    [[ "$seen" == *" $dev "* ]] && continue
    seen+="$dev "
    printf -v mp '%b' "${BASH_REMATCH[2]}"
    MOUNT_DEVS+=("$dev")
    MOUNT_POINTS+=("$mp")
    MOUNT_TYPES+=("${BASH_REMATCH[3]}")
  done
}

# disk_mounts: the mount points the disk read-out can follow.
disk_mounts() {
  local list="" mp quoted
  real_mounts_scan "$MOUNTS_FILE"
  for mp in "${MOUNT_POINTS[@]}"; do
    quote_to quoted "$mp"
    list+="${list:+,}$quoted"
  done
  DISK_MOUNTS_JSON="[$list]"
}

assemble_disk() {
  if [[ "$VAL_DISK_USED_PCT" == "null" && "$VAL_DISK_READ" == "null" && "$VAL_DISK_WRITE" == "null" ]]; then
    return 0
  fi
  local mount
  quote_to mount "$DISK_MOUNT"
  DISK_JSON="{\"mount\":$mount,\"mounts\":$DISK_MOUNTS_JSON,\"used_pct\":$VAL_DISK_USED_PCT,\"used_b\":$VAL_DISK_USED_B,\"total_b\":$VAL_DISK_TOTAL_B,\"read_bps\":$VAL_DISK_READ,\"write_bps\":$VAL_DISK_WRITE}"
}

# ---------------------------------------------------------------------------
# gpu_detail assembly (null unless some subfield answered)
# ---------------------------------------------------------------------------
assemble_gpu_detail() {
  local used="null" total="null" watts="null"
  case "$GPU_SOURCE" in
    nvidia)
      used="$NVIDIA_VRAM_USED_B"
      total="$NVIDIA_VRAM_TOTAL_B"
      watts="$NVIDIA_WATTS"
      ;;
    amd)
      used="$AMD_VRAM_USED_B"
      total="$AMD_VRAM_TOTAL_B"
      watts="$AMD_WATTS"
      ;;
  esac
  if [[ "$used" != "null" || "$total" != "null" || "$watts" != "null" ]]; then
    GPU_DETAIL_JSON="{\"vram_used_b\":$used,\"vram_total_b\":$total,\"watts\":$watts}"
  fi
}

# ---------------------------------------------------------------------------
# --info: the facts that cannot change while the machine runs (model
# names, sizes, drivers), printed once as one JSON object for the menu.
# Raw facts only: the widget decides how to name them. Every path goes
# through INFO_ROOT, so the tests can hand in a fake machine.
# ---------------------------------------------------------------------------

# fact_to <var> <path>: the first line of $INFO_ROOT<path>, trimmed, or
# "" when it cannot be read.
fact_to() {
  read_to "$1" "$INFO_ROOT$2" || printf -v "$1" '%s' ""
}

# str_json_to <var> <string>: a JSON string, or null for "".
str_json_to() {
  if [[ -n "${2:-}" ]]; then
    quote_to "$1" "$2"
  else
    printf -v "$1" '%s' "null"
  fi
}

# uint_json_to <var> <string>: the integer, or null.
uint_json_to() {
  if is_uint "${2:-}"; then
    printf -v "$1" '%s' "$((10#$2))"
  else
    printf -v "$1" '%s' "null"
  fi
}

# link_path_to <var> <symlink to a directory>: the physical path behind
# it, resolved by the shell's own cd (no readlink fork), or "".
link_path_to() {
  local __link_here="$PWD" __link_path=""
  if cd -P -- "$2" 2>/dev/null; then
    __link_path="$PWD"
    cd -- "$__link_here" 2>/dev/null || true
  fi
  printf -v "$1" '%s' "$__link_path"
}

info_system() {
  local vendor product version board_vendor board kernel boot="" line
  local -a lines=()
  fact_to vendor /sys/class/dmi/id/sys_vendor
  fact_to product /sys/class/dmi/id/product_name
  fact_to version /sys/class/dmi/id/product_version
  fact_to board_vendor /sys/class/dmi/id/board_vendor
  fact_to board /sys/class/dmi/id/board_name
  fact_to kernel /proc/sys/kernel/osrelease
  if lines_to lines "$INFO_ROOT/proc/stat"; then
    for line in "${lines[@]}"; do
      if [[ "$line" == "btime "* ]]; then
        boot="${line#btime }"
        break
      fi
    done
  fi
  local j_vendor j_product j_version j_board_vendor j_board j_kernel j_boot
  str_json_to j_vendor "$vendor"
  str_json_to j_product "$product"
  str_json_to j_version "$version"
  str_json_to j_board_vendor "$board_vendor"
  str_json_to j_board "$board"
  str_json_to j_kernel "$kernel"
  uint_json_to j_boot "$boot"
  INFO_SYSTEM_JSON="{\"vendor\":$j_vendor,\"product\":$j_product,\"version\":$j_version,\"board_vendor\":$j_board_vendor,\"board\":$j_board,\"kernel\":$j_kernel,\"boot_time\":$j_boot}"
}

info_cpu() {
  local -a lines=()
  local line model="" threads=0 cores=0 phys="" core="" seen=" "
  lines_to lines "$INFO_ROOT/proc/cpuinfo" || true
  for line in "${lines[@]}"; do
    case "$line" in
      processor[[:space:]]*:*) threads=$((threads + 1)); phys="" ;;
      "model name"*:*) [[ -n "$model" ]] || cpu_model_clean_to model "${line#*:}" ;;
      "physical id"*:*) trim_to phys "${line#*:}" ;;
      "core id"*:*)
        # One core per (package, core) pair: SMT siblings share it.
        trim_to core "${line#*:}"
        if [[ "$seen" != *" $phys:$core "* ]]; then
          seen+="$phys:$core "
          cores=$((cores + 1))
        fi
        ;;
    esac
  done
  # Hybrid CPUs clock their cores differently: the fastest one counts.
  local f khz max=0
  for f in "$INFO_ROOT"/sys/devices/system/cpu/cpu[0-9]*/cpufreq/cpuinfo_max_freq; do
    read_to khz "$f" || continue
    if is_uint "$khz" && [[ "$khz" -gt "$max" ]]; then
      max="$khz"
    fi
  done
  # The last-level cache: the highest index level cpu0 reports.
  local d level size cache="" best=0
  for d in "$INFO_ROOT"/sys/devices/system/cpu/cpu0/cache/index[0-9]*; do
    read_to level "$d/level" || continue
    read_to size "$d/size" || continue
    is_uint "$level" || continue
    case "$size" in
      *K) size="${size%K}" ;;
      *M) size="${size%M}"; is_uint "$size" && size=$((size * 1024)) ;;
    esac
    if is_uint "$size" && [[ "$level" -gt "$best" ]]; then
      best="$level"
      cache="$size"
    fi
  done
  local governor driver
  fact_to governor /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
  fact_to driver /sys/devices/system/cpu/cpu0/cpufreq/scaling_driver
  # A count of zero means the file said nothing: null, not 0.
  [[ "$cores" -gt 0 ]] || cores=""
  [[ "$threads" -gt 0 ]] || threads=""
  [[ "$best" -gt 0 ]] || best=""
  local mhz=""
  [[ "$max" -gt 0 ]] && mhz=$((max / 1000))
  local j_model j_cores j_threads j_mhz j_cache j_level j_governor j_driver
  str_json_to j_model "$model"
  uint_json_to j_cores "$cores"
  uint_json_to j_threads "$threads"
  uint_json_to j_mhz "$mhz"
  uint_json_to j_cache "$cache"
  uint_json_to j_level "$best"
  str_json_to j_governor "$governor"
  str_json_to j_driver "$driver"
  INFO_CPU_JSON="{\"model\":$j_model,\"cores\":$j_cores,\"threads\":$j_threads,\"max_mhz\":$j_mhz,\"cache_kib\":$j_cache,\"cache_level\":$j_level,\"governor\":$j_governor,\"driver\":$j_driver}"
}

# pci_names_scan: GPU_NAMES[i] for every GPU_PCI[i] ("vendor:device"),
# in one pass over pci.ids. A vendor line starts in column 0; its
# devices follow, indented by one tab ("\t7d51  Arrow Lake-P [...]").
pci_names_scan() {
  local file="" f line vendor="" id i left=${#GPU_PCI[@]}
  for f in "$INFO_ROOT/usr/share/hwdata/pci.ids" "$INFO_ROOT/usr/share/misc/pci.ids"; do
    if [[ -r "$f" ]]; then
      file="$f"
      break
    fi
  done
  [[ -n "$file" && "$left" -gt 0 ]] || return 0
  while IFS= read -r line; do
    case "$line" in
      ''|'#'*|$'\t\t'*) continue ;;
      $'\t'*)
        [[ -n "$vendor" ]] || continue
        id="$vendor:${line:1:4}"
        for i in "${!GPU_PCI[@]}"; do
          if [[ "${GPU_PCI[i]}" == "$id" && -z "${GPU_NAMES[i]}" ]]; then
            trim_to "GPU_NAMES[$i]" "${line:5}"
            left=$((left - 1))
          fi
        done
        [[ "$left" -gt 0 ]] || break
        ;;
      *)
        vendor=""
        for i in "${!GPU_PCI[@]}"; do
          if [[ "${GPU_PCI[i]}" == "${line:0:4}:"* ]]; then
            vendor="${line:0:4}"
          fi
        done
        ;;
    esac
  done < "$file"
}

info_gpus() {
  GPU_PCI=()
  GPU_NAMES=()
  local -a sources=() drivers=()
  local card vendor device path
  for card in "$INFO_ROOT"/sys/class/drm/card[0-9]*; do
    # card0, not its connectors (card0-eDP-1); boot framebuffers have no
    # PCI ids and drop out here too.
    [[ "${card##*/}" =~ ^card[0-9]+$ ]] || continue
    read_to vendor "$card/device/vendor" || continue
    read_to device "$card/device/device" || continue
    vendor="${vendor#0x}"
    device="${device#0x}"
    GPU_PCI+=("${vendor,,}:${device,,}")
    GPU_NAMES+=("")
    case "${vendor,,}" in
      10de) sources+=("nvidia") ;;
      1002) sources+=("amd") ;;
      8086) sources+=("intel") ;;
      *) sources+=("") ;;
    esac
    link_path_to path "$card/device/driver"
    drivers+=("${path##*/}")
  done
  pci_names_scan
  local list="" i j_source j_name j_driver j_pci
  for i in "${!GPU_PCI[@]}"; do
    str_json_to j_source "${sources[i]}"
    str_json_to j_name "${GPU_NAMES[i]}"
    str_json_to j_driver "${drivers[i]}"
    quote_to j_pci "${GPU_PCI[i]}"
    list+="${list:+,}{\"source\":$j_source,\"name\":$j_name,\"driver\":$j_driver,\"pci\":$j_pci}"
  done
  INFO_GPUS_JSON="[$list]"
}

info_mem() {
  local -a lines=()
  local line total="" list="" kind j_total
  if lines_to lines "$INFO_ROOT/proc/meminfo"; then
    for line in "${lines[@]}"; do
      if [[ "$line" =~ ^MemTotal:[[:space:]]+([0-9]+) ]]; then
        total="${BASH_REMATCH[1]}"
        break
      fi
    done
  fi
  # /proc/swaps: a header, then name, type, size in KiB.
  if lines_to lines "$INFO_ROOT/proc/swaps"; then
    for line in "${lines[@]}"; do
      [[ "$line" =~ ^([^[:space:]]+)[[:space:]]+([^[:space:]]+)[[:space:]]+([0-9]+) ]] || continue
      case "${BASH_REMATCH[1]}" in
        /dev/zram*) kind="zram" ;;
        *) kind="${BASH_REMATCH[2]}" ;;
      esac
      quote_to kind "$kind"
      list+="${list:+,}{\"kind\":$kind,\"size_kib\":${BASH_REMATCH[3]}}"
    done
  fi
  uint_json_to j_total "$total"
  INFO_MEM_JSON="{\"total_kib\":$j_total,\"swaps\":[$list]}"
}

info_net() {
  local d name state mac speed wireless virtual list="" j_name j_state j_mac j_speed
  for d in "$INFO_ROOT"/sys/class/net/*; do
    name="${d##*/}"
    [[ -d "$d" ]] && is_real_iface "$name" || continue
    fact_to state "/sys/class/net/$name/operstate"
    fact_to mac "/sys/class/net/$name/address"
    [[ "$mac" != "00:00:00:00:00:00" ]] || mac=""
    # A down link and Wi-Fi report no speed (the read fails or says -1).
    fact_to speed "/sys/class/net/$name/speed"
    if ! is_uint "$speed" || [[ "$speed" -eq 0 ]]; then
      speed=""
    fi
    wireless=false
    if [[ -d "$d/wireless" || -e "$d/phy80211" ]]; then
      wireless=true
    fi
    # A VPN or a bridge has no device behind it.
    virtual=true
    if [[ -e "$d/device" ]]; then
      virtual=false
    fi
    quote_to j_name "$name"
    str_json_to j_state "$state"
    str_json_to j_mac "$mac"
    uint_json_to j_speed "$speed"
    list+="${list:+,}{\"iface\":$j_name,\"wireless\":$wireless,\"virtual\":$virtual,\"state\":$j_state,\"mbps\":$j_speed,\"mac\":$j_mac}"
  done
  INFO_NET_JSON="[$list]"
}

# block_disk_to <var> <device path>: the whole disk behind a mounted
# device. /dev/mapper/<name> goes down device-mapper to its first slave
# (LUKS, LVM, both stacked), and a partition up to its disk. "" when
# the chain breaks.
block_disk_to() {
  local __sys="$INFO_ROOT/sys/class/block" __name="${2##*/}" __d __n __path __hops=0
  if [[ "$2" == /dev/mapper/* ]]; then
    __name=""
    for __d in "$__sys"/dm-*; do
      if read_to __n "$__d/dm/name" && [[ "$__n" == "${2##*/}" ]]; then
        __name="${__d##*/}"
        break
      fi
    done
  fi
  while [[ "$__name" == dm-* && "$__hops" -lt 8 ]]; do
    __hops=$((__hops + 1))
    __n=""
    for __d in "$__sys/$__name/slaves"/*; do
      if [[ -e "$__d" ]]; then
        __n="${__d##*/}"
        break
      fi
    done
    __name="$__n"
  done
  if [[ -n "$__name" && -e "$__sys/$__name/partition" ]]; then
    link_path_to __path "$__sys/$__name"
    __path="${__path%/*}"
    __name="${__path##*/}"
  fi
  if [[ -z "$__name" || ! -e "$__sys/$__name/size" ]]; then
    __name=""
  fi
  printf -v "$1" '%s' "$__name"
}

info_disks() {
  local i disk model sectors bytes list="" j_mount j_fs j_disk j_model j_size
  real_mounts_scan "$INFO_ROOT/proc/mounts"
  for i in "${!MOUNT_POINTS[@]}"; do
    block_disk_to disk "${MOUNT_DEVS[i]}"
    model=""
    bytes=""
    if [[ -n "$disk" ]]; then
      fact_to model "/sys/class/block/$disk/device/model"
      [[ -n "$model" ]] || fact_to model "/sys/class/block/$disk/device/name"
      fact_to sectors "/sys/class/block/$disk/size"
      # The kernel counts a block device in 512-byte sectors.
      is_uint "$sectors" && bytes=$((sectors * 512))
    fi
    quote_to j_mount "${MOUNT_POINTS[i]}"
    quote_to j_fs "${MOUNT_TYPES[i]}"
    str_json_to j_disk "$disk"
    str_json_to j_model "$model"
    uint_json_to j_size "$bytes"
    list+="${list:+,}{\"mount\":$j_mount,\"fs\":$j_fs,\"device\":$j_disk,\"model\":$j_model,\"size_b\":$j_size}"
  done
  INFO_DISKS_JSON="[$list]"
}

emit_info() {
  info_system
  info_cpu
  info_gpus
  info_mem
  info_net
  info_disks
  printf '{"info":1,"system":%s,"cpu":%s,"gpus":%s,"mem":%s,"net":%s,"disks":%s}\n' \
    "$INFO_SYSTEM_JSON" "$INFO_CPU_JSON" "$INFO_GPUS_JSON" "$INFO_MEM_JSON" \
    "$INFO_NET_JSON" "$INFO_DISKS_JSON"
}

# ---------------------------------------------------------------------------
# Emit one JSON line
# ---------------------------------------------------------------------------
emit_reading() {
  READINGS=$((READINGS + 1))
  if [[ $((READINGS % RESCAN_EVERY)) -eq 0 ]] && needs_sensors; then
    scan_sensors
    if [[ "$GPU_SOURCE" == "intel" ]]; then
      scan_intel_engines
    fi
  fi
  reset_reading
  if wants cpu; then provider_cpu_usage; fi
  if wants mem; then provider_memory; fi
  if wants temp; then provider_hwmon_temp; fi
  if wants fans; then provider_fans; fi
  if wants gpu; then provider_gpu; assemble_gpu_detail; fi
  if wants clocks; then provider_clocks; fi
  if wants load; then provider_load; fi
  if wants net; then provider_net; assemble_net; fi
  if wants disk; then provider_disk_usage; fi
  if wants io; then provider_disk_io; fi
  if wants mounts; then disk_mounts; fi
  assemble_disk
  local gpu_source="null"
  if [[ "$GPU_SOURCE" != "none" && "$GPU_SOURCE" != "undecided" ]]; then
    gpu_source="\"$GPU_SOURCE\""
  fi
  printf '{"schema":2,"cpu":%s,"temp":%s,"mem":%s,"gpu":%s,"gpu_temp":%s,"gpu_source":%s,"gpu_sources":%s,"fans":%s,"cpu_mhz":%s,"gpu_mhz":%s,"mem_used_kib":%s,"mem_total_kib":%s,"swap_used_kib":%s,"swap_total_kib":%s,"cpu_model":%s,"cpu_cores":%s,"load":%s,"gpu_detail":%s,"net":%s,"disk":%s}\n' \
    "$VAL_CPU" "$VAL_TEMP" "$VAL_MEM" "$VAL_GPU" "$VAL_GPU_TEMP" "$gpu_source" "$GPU_SOURCES_JSON" "$FANS_JSON" \
    "$VAL_CPU_MHZ" "$VAL_GPU_MHZ" "$VAL_MEM_USED" "$VAL_MEM_TOTAL" \
    "$VAL_SWAP_USED" "$VAL_SWAP_TOTAL" "$VAL_CPU_MODEL_JSON" "$VAL_CPU_CORES" \
    "$LOAD_JSON" "$GPU_DETAIL_JSON" "$NET_JSON" "$DISK_JSON"
}

# needs_sensors: succeeds when a wanted provider reads the hwmon or
# cpufreq files that scan_sensors finds.
needs_sensors() {
  wants temp || wants fans || wants gpu || wants clocks
}

# prime_deltas: the first sample of every rate, so the first line
# already reports a real delta instead of a priming null.
prime_deltas() {
  if wants cpu; then provider_cpu_usage; fi
  if wants gpu && [[ "$GPU_SOURCE" == "intel" ]]; then provider_gpu_intel; fi
  if wants net; then provider_net; fi
  if wants io; then provider_disk_io; fi
}

# pause <seconds>: wait on a pipe nobody writes to, so a pause forks no
# `sleep`.
pause() {
  read -r -t "$1" -u "$TICK" _ || true
}

usage() {
  echo "usage: sysread [--loop --interval N | --info]" >&2
}

main() {
  local mode="once"
  local interval=""
  if [[ "$#" -eq 0 ]]; then
    mode="once"
  elif [[ "${1:-}" == "--info" && "$#" -eq 1 ]]; then
    emit_info
    return 0
  elif [[ "${1:-}" == "--loop" ]]; then
    mode="loop"
    if [[ "${2:-}" != "--interval" || -z "${3:-}" || "$#" -gt 3 ]]; then
      usage
      return 1
    fi
    interval="$3"
    if ! is_number "$interval" || [[ "$interval" =~ ^[+-]?0*\.?0*$ || "$interval" == -* ]]; then
      echo "sysread: interval must be a positive number" >&2
      return 1
    fi
  else
    usage
    return 1
  fi

  exec {TICK}<> <(:)
  if needs_sensors; then
    scan_sensors
  fi
  if wants gpu; then
    scan_intel_engines
    pick_gpu_source
  fi
  # The CPU model and core count ride with the CPU group's load average.
  if wants load; then
    provider_cpu_info_once
  fi

  # Every line, the first included, reports deltas over at least 0.2 s.
  prime_deltas
  pause 0.2
  emit_reading
  if [[ "$mode" == "loop" ]]; then
    while true; do
      pause "$interval"
      emit_reading
    done
  fi
}

main "$@"
