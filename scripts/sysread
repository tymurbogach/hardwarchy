#!/usr/bin/env bash
# sysread - one-shot / streaming hardware sensor collector.
# Reads /proc, /sys/class/hwmon (+ drm for Intel) and nvidia-smi (if present).
# Emits one JSON object per line, schema version 1. See SPEC section 2.
set -u

HWMON_ROOT="${MONITOR_HWMON_ROOT:-/sys/class/hwmon}"
DRM_ROOT="${MONITOR_DRM_ROOT:-/sys/class/drm}"

# ---------------------------------------------------------------------------
# Persistent state (priming / once-only detection)
# ---------------------------------------------------------------------------
CPU_PREV_IDLE=""
CPU_PREV_TOTAL=""
GPU_SOURCE="undecided" # nvidia | amd | intel | none
CPU_MODEL_CACHED=""
CPU_CORES_CACHED=""
CPU_INFO_DONE=0
INTEL_PREV_BUSY=""
INTEL_PREV_TIME_NS=""

# Per-reading values (JSON fragments: number or the literal "null", except
# fans/load/detail/model which hold ready-made JSON snippets).
VAL_CPU="null"
VAL_TEMP="null"
VAL_MEM="null"
VAL_GPU="null"
VAL_GPU_TEMP="null"
FANS_JSON="[]"
VAL_CPU_MHZ="null"
VAL_GPU_MHZ="null"
VAL_MEM_USED="null"
VAL_MEM_TOTAL="null"
VAL_SWAP_USED="null"
VAL_SWAP_TOTAL="null"
VAL_CPU_MODEL_JSON="null"
VAL_CPU_CORES="null"
LOAD_JSON="null"
GPU_DETAIL_JSON="null"
# NVIDIA per-reading cache (filled by exactly one nvidia-smi call per reading)
NVIDIA_UTIL="null"
NVIDIA_TEMP="null"
NVIDIA_CLOCK="null"
NVIDIA_VRAM_USED_B="null"
NVIDIA_VRAM_TOTAL_B="null"
NVIDIA_WATTS="null"

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

# trim <string>: strip leading/trailing whitespace (space, tab, CR, newline).
trim() {
  local s="${1:-}"
  # strip leading
  s="${s#"${s%%[![:space:]]*}"}"
  # strip trailing
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# json_quote <string>: print the string as a JSON string literal.
json_quote() {
  local s="${1:-}"
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\b'/\\b}
  s=${s//$'\f'/\\f}
  printf '"%s"' "$s"
}

# is_uint <string>: succeeds if the string is a non-negative integer.
is_uint() {
  case "${1:-}" in
    ''|*[!0-9]*) return 1 ;;
    *) return 0 ;;
  esac
}

# is_number <string>: succeeds for JSON-style decimal numbers.
is_number() {
  case "${1:-}" in
    ''|*[!0-9.+-eE]*) return 1 ;;
  esac
  [[ "${1:-}" =~ ^[+-]?([0-9]+(\.[0-9]*)?|\.[0-9]+)([eE][+-]?[0-9]+)?$ ]]
}

# read_first_line <file>: print first line of file, or fail.
read_first_line() {
  local f="$1"
  local line=""
  IFS= read -r line < "$f" 2>/dev/null || return 1
  printf '%s' "$line"
}

# chip_name_for <hwmon_dir>: contents of "name" file, else dir basename.
chip_name_for() {
  local dir="$1"
  local name=""
  if name="$(read_first_line "$dir/name" 2>/dev/null)"; then
    name="$(trim "$name")"
    if [[ -n "$name" ]]; then
      printf '%s' "$name"
      return 0
    fi
  fi
  printf '%s' "${dir##*/}"
}

# to_lower <string>
to_lower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

# ---------------------------------------------------------------------------
# provider: cpu_info (cpu_model / cpu_cores, detected once)
# ---------------------------------------------------------------------------
provider_cpu_info_once() {
  if [[ "$CPU_INFO_DONE" -eq 1 ]]; then
    return 0
  fi
  CPU_INFO_DONE=1
  CPU_MODEL_CACHED=""
  CPU_CORES_CACHED=""
  if [[ -r /proc/cpuinfo ]]; then
    local model=""
    model="$(awk -F: '/^model name/ {sub(/^[ \t]+/, "", $2); print $2; exit}' /proc/cpuinfo 2>/dev/null || true)"
    model="$(trim "${model:-}")"
    CPU_MODEL_CACHED="$model"
    local cores=""
    cores="$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || true)"
    cores="$(trim "${cores:-}")"
    if is_uint "$cores"; then
      CPU_CORES_CACHED="$cores"
    else
      CPU_CORES_CACHED=""
    fi
  fi
  if [[ -n "$CPU_MODEL_CACHED" ]]; then
    VAL_CPU_MODEL_JSON="$(json_quote "$CPU_MODEL_CACHED")"
  else
    VAL_CPU_MODEL_JSON="null"
  fi
  if [[ -n "$CPU_CORES_CACHED" ]]; then
    VAL_CPU_CORES="$CPU_CORES_CACHED"
  else
    VAL_CPU_CORES="null"
  fi
}

# ---------------------------------------------------------------------------
# provider: cpu (percentage via /proc/stat delta; first call primes -> null)
# ---------------------------------------------------------------------------
provider_cpu_usage() {
  local line=""
  if ! line="$(awk '/^cpu /{print $2, $3, $4, $5, $6, $7, $8, $9; exit}' /proc/stat 2>/dev/null)"; then
    VAL_CPU="null"
    return 0
  fi
  if [[ -z "$line" ]]; then
    VAL_CPU="null"
    return 0
  fi
  local user nice system idle iowait irq softirq steal
  read -r user nice system idle iowait irq softirq steal <<< "$line"
  for v in "$user" "$nice" "$system" "$idle" "$iowait" "$irq" "$softirq" "$steal"; do
    if ! is_uint "$v"; then
      VAL_CPU="null"
      return 0
    fi
  done
  local cur_idle=$((idle + iowait))
  local cur_total=$((user + nice + system + idle + iowait + irq + softirq + steal))
  if [[ -z "$CPU_PREV_IDLE" || -z "$CPU_PREV_TOTAL" ]]; then
    CPU_PREV_IDLE="$cur_idle"
    CPU_PREV_TOTAL="$cur_total"
    VAL_CPU="null"
    return 0
  fi
  local d_idle=$((cur_idle - CPU_PREV_IDLE))
  local d_total=$((cur_total - CPU_PREV_TOTAL))
  CPU_PREV_IDLE="$cur_idle"
  CPU_PREV_TOTAL="$cur_total"
  if [[ "$d_total" -le 0 ]]; then
    VAL_CPU="null"
    return 0
  fi
  local busy=$((d_total - d_idle))
  if [[ "$busy" -lt 0 ]]; then
    busy=0
  fi
  # rounded percent
  local pct=$(((busy * 100 + d_total / 2) / d_total))
  if [[ "$pct" -lt 0 ]]; then pct=0; fi
  if [[ "$pct" -gt 100 ]]; then pct=100; fi
  VAL_CPU="$pct"
}

# ---------------------------------------------------------------------------
# provider: memory (percentage + KiB counters from /proc/meminfo)
# ---------------------------------------------------------------------------
provider_memory() {
  VAL_MEM="null"
  VAL_MEM_USED="null"
  VAL_MEM_TOTAL="null"
  VAL_SWAP_USED="null"
  VAL_SWAP_TOTAL="null"
  if [[ ! -r /proc/meminfo ]]; then
    return 0
  fi
  local mem_total="" mem_avail="" swap_total="" swap_free=""
  mem_total="$(awk '/^MemTotal:/{print $2; exit}' /proc/meminfo 2>/dev/null || true)"
  mem_avail="$(awk '/^MemAvailable:/{print $2; exit}' /proc/meminfo 2>/dev/null || true)"
  swap_total="$(awk '/^SwapTotal:/{print $2; exit}' /proc/meminfo 2>/dev/null || true)"
  swap_free="$(awk '/^SwapFree:/{print $2; exit}' /proc/meminfo 2>/dev/null || true)"
  if is_uint "$mem_total" && is_uint "$mem_avail"; then
    VAL_MEM_TOTAL="$mem_total"
    local used=$((mem_total - mem_avail))
    if [[ "$used" -lt 0 ]]; then used=0; fi
    VAL_MEM_USED="$used"
    if [[ "$mem_total" -gt 0 ]]; then
      VAL_MEM="$(((used * 100 + mem_total / 2) / mem_total))"
    fi
  fi
  if is_uint "$swap_total"; then
    VAL_SWAP_TOTAL="$swap_total"
    if is_uint "$swap_free"; then
      local s_used=$((swap_total - swap_free))
      if [[ "$s_used" -lt 0 ]]; then s_used=0; fi
      VAL_SWAP_USED="$s_used"
    else
      VAL_SWAP_USED="$swap_total"
    fi
  fi
}

# ---------------------------------------------------------------------------
# provider: hwmon temperature (package preference, sane-range fallback)
# ---------------------------------------------------------------------------
provider_hwmon_temp() {
  VAL_TEMP="null"
  local pref=""
  local fallback=""
  local chip_dir
  # Expand glob safely; empty tree must not fail under set -u.
  local -a dirs=()
  for chip_dir in "$HWMON_ROOT"/*; do
    [[ -d "$chip_dir" ]] || continue
    dirs+=("$chip_dir")
  done
  if [[ "${#dirs[@]}" -eq 0 ]]; then
    return 0
  fi
  local dir chip chip_lc input label_file label raw celsius
  for dir in "${dirs[@]}"; do
    chip="$(chip_name_for "$dir")"
    chip_lc="$(to_lower "$chip")"
    for input in "$dir"/temp*_input; do
      [[ -e "$input" ]] || continue
      [[ -f "$input" ]] || continue
      if ! raw="$(read_first_line "$input")"; then
        continue
      fi
      raw="$(trim "$raw")"
      case "$raw" in
        ''|*[!0-9-]*) continue ;;
      esac
      if [[ ! "$raw" =~ ^-?[0-9]+$ ]]; then
        continue
      fi
      celsius=$((raw / 1000))
      # sane range (0, 150) applies to every candidate
      if [[ "$celsius" -le 0 || "$celsius" -ge 150 ]]; then
        continue
      fi
      label_file="${input%_input}_label"
      label=""
      if [[ -f "$label_file" ]]; then
        label="$(read_first_line "$label_file" 2>/dev/null || true)"
        label="$(trim "$label")"
      fi
      local is_pref=0
      if [[ "$chip_lc" == "k10temp" || "$chip_lc" == "zenpower" ]]; then
        if [[ "$label" == "Tctl" || "$label" == "Tdie" ]]; then
          is_pref=1
        fi
      elif [[ "$chip_lc" == "coretemp" ]]; then
        if [[ "$label" == *"Package id"* ]]; then
          is_pref=1
        fi
      fi
      if [[ "$is_pref" -eq 1 ]]; then
        if [[ -z "$pref" || "$celsius" -gt "$pref" ]]; then
          pref="$celsius"
        fi
      else
        if [[ -z "$fallback" || "$celsius" -gt "$fallback" ]]; then
          fallback="$celsius"
        fi
      fi
    done
  done
  if [[ -n "$pref" ]]; then
    VAL_TEMP="$pref"
  elif [[ -n "$fallback" ]]; then
    VAL_TEMP="$fallback"
  else
    VAL_TEMP="null"
  fi
}

# ---------------------------------------------------------------------------
# provider: fans (every readable fan as {id,chip,label,rpm})
# ---------------------------------------------------------------------------
provider_fans() {
  FANS_JSON="[]"
  local -a rows=()
  local chip_dir
  for chip_dir in "$HWMON_ROOT"/*; do
    [[ -d "$chip_dir" ]] || continue
    local chip
    chip="$(chip_name_for "$chip_dir")"
    local input
    for input in "$chip_dir"/fan*_input; do
      [[ -e "$input" ]] || continue
      [[ -f "$input" ]] || continue
      local base fan_name fnum label_file label raw
      base="${input##*/}"            # e.g. fan1_input
      fan_name="${base%_input}"      # e.g. fan1
      case "$fan_name" in
        fan*) ;;
        *) continue ;;
      esac
      fnum="${fan_name#fan}"
      if ! is_uint "$fnum"; then
        fnum="$fan_name"
      fi
      if ! raw="$(read_first_line "$input")"; then
        continue
      fi
      raw="$(trim "$raw")"
      if ! is_uint "$raw"; then
        continue
      fi
      label_file="$chip_dir/${fan_name}_label"
      label=""
      if [[ -f "$label_file" ]]; then
        label="$(read_first_line "$label_file" 2>/dev/null || true)"
        label="$(trim "$label")"
      fi
      if [[ -z "$label" ]]; then
        if is_uint "$fnum"; then
          label="Fan $fnum"
        else
          label="Fan $fan_name"
        fi
      fi
      local id="$chip/$fan_name"
      rows+=("$id|$chip|$label|$raw")
    done
  done
  if [[ "${#rows[@]}" -eq 0 ]]; then
    FANS_JSON="[]"
    return 0
  fi
  # stable order: sort by id
  local sorted
  sorted="$(printf '%s\n' "${rows[@]}" | LC_ALL=C sort)"
  local json="[" first=1
  local line id chip label rpm
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    IFS='|' read -r id chip label rpm <<< "$line"
    local jid jchip jlabel
    jid="$(json_quote "$id")"
    jchip="$(json_quote "$chip")"
    jlabel="$(json_quote "$label")"
    if [[ "$first" -eq 1 ]]; then
      first=0
    else
      json+=","
    fi
    json+="{\"id\":$jid,\"chip\":$jchip,\"label\":$jlabel,\"rpm\":$rpm}"
  done <<< "$sorted"
  json+="]"
  FANS_JSON="$json"
}

# ---------------------------------------------------------------------------
# GPU source selection (once at startup)
# ---------------------------------------------------------------------------
pick_gpu_source() {
  if [[ "$GPU_SOURCE" != "undecided" ]]; then
    return 0
  fi
  # 1) nvidia-smi present and answering?
  if command -v nvidia-smi >/dev/null 2>&1; then
    local probe=""
    probe="$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -n 1 || true)"
    probe="$(trim "${probe:-}")"
    # answering means a numeric utilization on the first line
    if [[ "$probe" =~ ^[0-9]+ ]]; then
      GPU_SOURCE="nvidia"
      return 0
    fi
  fi
  # 2) amdgpu gpu_busy_percent anywhere under the hwmon root?
  local d
  for d in "$HWMON_ROOT"/*; do
    [[ -d "$d" ]] || continue
    if [[ -f "$d/gpu_busy_percent" && -r "$d/gpu_busy_percent" ]]; then
      GPU_SOURCE="amd"
      return 0
    fi
  done
  # 3) Intel drm busy_time engines?
  local b
  for b in "$DRM_ROOT"/card*/engine/*/busy_time "$DRM_ROOT"/card*/gt*/busy_time; do
    if [[ -f "$b" && -r "$b" ]]; then
      GPU_SOURCE="intel"
      return 0
    fi
  done
  # also try nested engine dirs one level deeper (robustness, still cheap)
  if [[ -d "$DRM_ROOT" ]]; then
    local found=""
    found="$(find "$DRM_ROOT" -name busy_time -readable 2>/dev/null | head -n 1 || true)"
    if [[ -n "$found" ]]; then
      GPU_SOURCE="intel"
      return 0
    fi
  fi
  GPU_SOURCE="none"
}

# ---------------------------------------------------------------------------
# provider: gpu-nvidia (ONE nvidia-smi call per reading, shared fields)
# ---------------------------------------------------------------------------
provider_gpu_nvidia() {
  NVIDIA_UTIL="null"
  NVIDIA_TEMP="null"
  NVIDIA_CLOCK="null"
  NVIDIA_VRAM_USED_B="null"
  NVIDIA_VRAM_TOTAL_B="null"
  NVIDIA_WATTS="null"
  VAL_GPU="null"
  VAL_GPU_TEMP="null"
  VAL_GPU_MHZ="null"
  local out=""
  out="$(nvidia-smi --query-gpu=utilization.gpu,temperature.gpu,clocks.sm,memory.used,memory.total,power.draw --format=csv,noheader,nounits 2>/dev/null | head -n 1 || true)"
  if [[ -z "$(trim "$out")" ]]; then
    return 0
  fi
  local util temp clock mem_used mem_total power
  IFS=',' read -r util temp clock mem_used mem_total power <<< "$out"
  util="$(trim "${util:-}")"
  temp="$(trim "${temp:-}")"
  clock="$(trim "${clock:-}")"
  mem_used="$(trim "${mem_used:-}")"
  mem_total="$(trim "${mem_total:-}")"
  power="$(trim "${power:-}")"
  # utilization may arrive as "23" (single field query) or "23 %" etc; take leading int
  if [[ "$util" =~ ^([0-9]+) ]]; then
    NVIDIA_UTIL="${BASH_REMATCH[1]}"
    VAL_GPU="$NVIDIA_UTIL"
  fi
  if [[ "$temp" =~ ^([0-9]+) ]]; then
    NVIDIA_TEMP="${BASH_REMATCH[1]}"
    VAL_GPU_TEMP="$NVIDIA_TEMP"
  fi
  if [[ "$clock" =~ ^([0-9]+) ]]; then
    NVIDIA_CLOCK="${BASH_REMATCH[1]}"
    VAL_GPU_MHZ="$NVIDIA_CLOCK"
  fi
  if [[ "$mem_used" =~ ^([0-9]+) ]]; then
    NVIDIA_VRAM_USED_B="$((BASH_REMATCH[1] * 1048576))"
  fi
  if [[ "$mem_total" =~ ^([0-9]+) ]]; then
    NVIDIA_VRAM_TOTAL_B="$((BASH_REMATCH[1] * 1048576))"
  fi
  # power like "45.00" or "[N/A]"
  if is_number "$power"; then
    NVIDIA_WATTS="$power"
  elif [[ "$power" =~ ^([0-9]*\.?[0-9]+) ]]; then
    NVIDIA_WATTS="${BASH_REMATCH[1]}"
  fi
}

# ---------------------------------------------------------------------------
# provider: gpu-amd (gpu_busy_percent + amdgpu sysfs VRAM/power/clocks/temp)
# ---------------------------------------------------------------------------
provider_gpu_amd() {
  VAL_GPU="null"
  VAL_GPU_TEMP="null"
  VAL_GPU_MHZ="null"
  local vram_used="null" vram_total="null" watts="null"
  # utilization: first readable numeric gpu_busy_percent (sorted for stability)
  local d f raw
  for d in "$HWMON_ROOT"/*; do
    [[ -d "$d" ]] || continue
    f="$d/gpu_busy_percent"
    [[ -f "$f" ]] || continue
    if ! raw="$(read_first_line "$f")"; then
      continue
    fi
    raw="$(trim "$raw")"
    if [[ "$raw" =~ ^([0-9]+) ]]; then
      VAL_GPU="${BASH_REMATCH[1]}"
      break
    fi
  done
  # gpu temp: hottest sane temp among amdgpu chips
  local best=""
  for d in "$HWMON_ROOT"/*; do
    [[ -d "$d" ]] || continue
    local chip
    chip="$(chip_name_for "$d")"
    if [[ "$(to_lower "$chip")" != *amdgpu* ]]; then
      continue
    fi
    local input
    for input in "$d"/temp*_input; do
      [[ -e "$input" ]] || continue
      if ! raw="$(read_first_line "$input")"; then
        continue
      fi
      raw="$(trim "$raw")"
      if [[ ! "$raw" =~ ^-?[0-9]+$ ]]; then
        continue
      fi
      local c=$((raw / 1000))
      if [[ "$c" -le 0 || "$c" -ge 150 ]]; then
        continue
      fi
      if [[ -z "$best" || "$c" -gt "$best" ]]; then
        best="$c"
      fi
    done
  done
  if [[ -n "$best" ]]; then
    VAL_GPU_TEMP="$best"
  fi
  # gpu clock: prefer freq1_input (sclk) under amdgpu, else hottest freq*_input
  local mhz=""
  for d in "$HWMON_ROOT"/*; do
    [[ -d "$d" ]] || continue
    local chip
    chip="$(chip_name_for "$d")"
    if [[ "$(to_lower "$chip")" != *amdgpu* ]]; then
      continue
    fi
    if [[ -f "$d/freq1_input" ]]; then
      if raw="$(read_first_line "$d/freq1_input" 2>/dev/null)"; then
        raw="$(trim "$raw")"
        if is_uint "$raw" && [[ "$raw" -gt 0 ]]; then
          local m=$((raw / 1000000))
          if [[ "$m" -gt 0 && ( -z "$mhz" || "$m" -gt "$mhz" ) ]]; then
            mhz="$m"
          fi
        fi
      fi
    fi
  done
  if [[ -z "$mhz" ]]; then
    # fallback: max over any freq*_input under amdgpu
    for d in "$HWMON_ROOT"/*; do
      [[ -d "$d" ]] || continue
      local chip
      chip="$(chip_name_for "$d")"
      if [[ "$(to_lower "$chip")" != *amdgpu* ]]; then
        continue
      fi
      local input
      for input in "$d"/freq*_input; do
        [[ -e "$input" ]] || continue
        if ! raw="$(read_first_line "$input")"; then
          continue
        fi
        raw="$(trim "$raw")"
        if is_uint "$raw" && [[ "$raw" -gt 0 ]]; then
          local m=$((raw / 1000000))
          if [[ "$m" -gt 0 && ( -z "$mhz" || "$m" -gt "$mhz" ) ]]; then
            mhz="$m"
          fi
        fi
      done
    done
  fi
  if [[ -n "$mhz" ]]; then
    VAL_GPU_MHZ="$mhz"
  fi
  # VRAM used/total (bytes already) + power (microwatts -> watts)
  for d in "$HWMON_ROOT"/*; do
    [[ -d "$d" ]] || continue
    local chip
    chip="$(chip_name_for "$d")"
    if [[ "$(to_lower "$chip")" != *amdgpu* ]]; then
      continue
    fi
    if [[ "$vram_used" == "null" && -f "$d/mem_info_vram_used" ]]; then
      if raw="$(read_first_line "$d/mem_info_vram_used" 2>/dev/null)"; then
        raw="$(trim "$raw")"
        if is_uint "$raw"; then
          vram_used="$raw"
        fi
      fi
    fi
    if [[ "$vram_total" == "null" && -f "$d/mem_info_vram_total" ]]; then
      if raw="$(read_first_line "$d/mem_info_vram_total" 2>/dev/null)"; then
        raw="$(trim "$raw")"
        if is_uint "$raw"; then
          vram_total="$raw"
        fi
      fi
    fi
    if [[ "$watts" == "null" ]]; then
      local pfile=""
      if [[ -f "$d/power1_input" ]]; then
        pfile="$d/power1_input"
      else
        local cand
        for cand in "$d"/power*_input; do
          [[ -e "$cand" ]] || continue
          pfile="$cand"
          break
        done
      fi
      if [[ -n "$pfile" && -f "$pfile" ]]; then
        if raw="$(read_first_line "$pfile" 2>/dev/null)"; then
          raw="$(trim "$raw")"
          if is_uint "$raw"; then
            watts="$(awk -v uw="$raw" 'BEGIN { printf "%g", uw / 1000000 }')"
            if ! is_number "$watts"; then
              watts="null"
            fi
          fi
        fi
      fi
    fi
  done
  # stash for gpu_detail assembly
  AMD_VRAM_USED_B="$vram_used"
  AMD_VRAM_TOTAL_B="$vram_total"
  AMD_WATTS="$watts"
}

# per-reading AMD detail stash (declared here so set -u is happy)
AMD_VRAM_USED_B="null"
AMD_VRAM_TOTAL_B="null"
AMD_WATTS="null"

# ---------------------------------------------------------------------------
# provider: gpu-intel (summed drm busy_time deltas; primes -> null)
# ---------------------------------------------------------------------------
provider_gpu_intel() {
  VAL_GPU="null"
  VAL_GPU_TEMP="null"
  VAL_GPU_MHZ="null"
  local -a engines=()
  local b
  for b in "$DRM_ROOT"/card*/engine/*/busy_time "$DRM_ROOT"/card*/gt*/busy_time; do
    [[ -f "$b" && -r "$b" ]] || continue
    engines+=("$b")
  done
  if [[ "${#engines[@]}" -eq 0 && -d "$DRM_ROOT" ]]; then
    while IFS= read -r b; do
      [[ -n "$b" ]] || continue
      engines+=("$b")
    done < <(find "$DRM_ROOT" -name busy_time 2>/dev/null | LC_ALL=C sort || true)
  fi
  if [[ "${#engines[@]}" -eq 0 ]]; then
    return 0
  fi
  local total=0 f raw
  for f in "${engines[@]}"; do
    if raw="$(read_first_line "$f" 2>/dev/null)"; then
      raw="$(trim "$raw")"
      if is_uint "$raw"; then
        total=$((total + raw))
      fi
    fi
  done
  local now_ns=""
  now_ns="$(date +%s%N 2>/dev/null || true)"
  now_ns="$(trim "$now_ns")"
  if [[ ! "$now_ns" =~ ^[0-9]+$ ]]; then
    # date without %N support: fall back to seconds
    local now_s
    now_s="$(date +%s 2>/dev/null || true)"
    if is_uint "$now_s"; then
      now_ns="$((now_s * 1000000000))"
    else
      return 0
    fi
  fi
  if [[ -z "$INTEL_PREV_BUSY" || -z "$INTEL_PREV_TIME_NS" ]]; then
    INTEL_PREV_BUSY="$total"
    INTEL_PREV_TIME_NS="$now_ns"
    VAL_GPU="null"
    return 0
  fi
  local d_busy=$((total - INTEL_PREV_BUSY))
  local d_time=$((now_ns - INTEL_PREV_TIME_NS))
  INTEL_PREV_BUSY="$total"
  INTEL_PREV_TIME_NS="$now_ns"
  if [[ "$d_time" -le 0 ]]; then
    VAL_GPU="null"
    return 0
  fi
  if [[ "$d_busy" -lt 0 ]]; then
    # counter wrap / engine set changed: re-prime
    VAL_GPU="null"
    return 0
  fi
  local n="${#engines[@]}"
  # busy_time is in nanoseconds; utilization over wall * engine count
  local pct
  pct="$(awk -v db="$d_busy" -v dt="$d_time" -v n="$n" 'BEGIN { if (dt*n <= 0) { print "null" } else { printf "%d", (db*100 + dt*n/2) / (dt*n) } }')"
  if [[ "$pct" == "null" || -z "$pct" ]]; then
    VAL_GPU="null"
    return 0
  fi
  if [[ "$pct" -lt 0 ]]; then pct=0; fi
  if [[ "$pct" -gt 100 ]]; then pct=100; fi
  VAL_GPU="$pct"
}

# dispatch to whichever GPU source was picked once at startup
provider_gpu() {
  AMD_VRAM_USED_B="null"
  AMD_VRAM_TOTAL_B="null"
  AMD_WATTS="null"
  NVIDIA_UTIL="null"
  NVIDIA_TEMP="null"
  NVIDIA_CLOCK="null"
  NVIDIA_VRAM_USED_B="null"
  NVIDIA_VRAM_TOTAL_B="null"
  NVIDIA_WATTS="null"
  case "$GPU_SOURCE" in
    nvidia) provider_gpu_nvidia ;;
    amd) provider_gpu_amd ;;
    intel) provider_gpu_intel ;;
    *) VAL_GPU="null"; VAL_GPU_TEMP="null"; VAL_GPU_MHZ="null" ;;
  esac
}

# ---------------------------------------------------------------------------
# provider: clocks (mean CPU clock in MHz; GPU clock comes from GPU providers)
# ---------------------------------------------------------------------------
provider_clocks() {
  VAL_CPU_MHZ="null"
  local avg=""
  if [[ -r /proc/cpuinfo ]]; then
    avg="$(awk '/^cpu MHz/ { n++; s += $4 } END { if (n > 0) printf "%d", (s + n/2) / n }' /proc/cpuinfo 2>/dev/null || true)"
    avg="$(trim "${avg:-}")"
  fi
  if is_uint "$avg" && [[ "$avg" -gt 0 ]]; then
    VAL_CPU_MHZ="$avg"
    return 0
  fi
  # fallback: sysfs cpufreq (kHz -> MHz mean)
  local sum=0 count=0 f raw
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
    [[ -f "$f" ]] || continue
    if raw="$(read_first_line "$f" 2>/dev/null)"; then
      raw="$(trim "$raw")"
      if is_uint "$raw" && [[ "$raw" -gt 0 ]]; then
        sum=$((sum + raw))
        count=$((count + 1))
      fi
    fi
  done
  if [[ "$count" -gt 0 ]]; then
    # rounded mean MHz
    local mhz=$(((sum + count * 500) / count / 1000))
    if [[ "$mhz" -gt 0 ]]; then
      VAL_CPU_MHZ="$mhz"
    fi
  fi
}

# ---------------------------------------------------------------------------
# provider: load (from /proc/loadavg)
# ---------------------------------------------------------------------------
provider_load() {
  LOAD_JSON="null"
  if [[ ! -r /proc/loadavg ]]; then
    return 0
  fi
  local one five fifteen
  if ! read -r one five fifteen _ < /proc/loadavg 2>/dev/null; then
    return 0
  fi
  if is_number "$one" && is_number "$five" && is_number "$fifteen"; then
    LOAD_JSON="{\"one\":$one,\"five\":$five,\"fifteen\":$fifteen}"
  fi
}

# ---------------------------------------------------------------------------
# gpu_detail assembly (null unless some subfield answered)
# ---------------------------------------------------------------------------
assemble_gpu_detail() {
  local used="null" total="null" watts="null"
  case "$GPU_SOURCE" in
    nvidia)
      used="$NVIDIA_VRAM_USED_B"
      total="$NVIDIA_VRAM_TOTAL_B"
      watts="$NVIDIA_WATTS"
      ;;
    amd)
      used="$AMD_VRAM_USED_B"
      total="$AMD_VRAM_TOTAL_B"
      watts="$AMD_WATTS"
      ;;
    *)
      used="null"; total="null"; watts="null"
      ;;
  esac
  if [[ "$used" == "null" && "$total" == "null" && "$watts" == "null" ]]; then
    GPU_DETAIL_JSON="null"
  else
    GPU_DETAIL_JSON="{\"vram_used_b\":$used,\"vram_total_b\":$total,\"watts\":$watts}"
  fi
}

# ---------------------------------------------------------------------------
# Emit one JSON line
# ---------------------------------------------------------------------------
emit_reading() {
  provider_cpu_info_once
  provider_cpu_usage
  provider_memory
  provider_hwmon_temp
  provider_fans
  provider_gpu
  provider_clocks
  provider_load
  assemble_gpu_detail
  # cpu_model / cores already cached by provider_cpu_info_once
  printf '{"schema":1,"cpu":%s,"temp":%s,"mem":%s,"gpu":%s,"gpu_temp":%s,"fans":%s,"cpu_mhz":%s,"gpu_mhz":%s,"mem_used_kib":%s,"mem_total_kib":%s,"swap_used_kib":%s,"swap_total_kib":%s,"cpu_model":%s,"cpu_cores":%s,"load":%s,"gpu_detail":%s}\n' \
    "$VAL_CPU" "$VAL_TEMP" "$VAL_MEM" "$VAL_GPU" "$VAL_GPU_TEMP" "$FANS_JSON" \
    "$VAL_CPU_MHZ" "$VAL_GPU_MHZ" "$VAL_MEM_USED" "$VAL_MEM_TOTAL" \
    "$VAL_SWAP_USED" "$VAL_SWAP_TOTAL" "$VAL_CPU_MODEL_JSON" "$VAL_CPU_CORES" \
    "$LOAD_JSON" "$GPU_DETAIL_JSON"
}

usage() {
  echo "usage: sysread [--loop --interval N]" >&2
}

main() {
  local mode="once"
  local interval=""
  if [[ "$#" -eq 0 ]]; then
    mode="once"
  elif [[ "${1:-}" == "--loop" ]]; then
    mode="loop"
    if [[ "${2:-}" != "--interval" || -z "${3:-}" ]]; then
      usage
      return 1
    fi
    interval="$3"
    if [[ "$interval" =~ ^[0-9]+$ ]]; then
      if [[ "$interval" -le 0 ]]; then
        echo "sysread: interval must be a positive number" >&2
        return 1
      fi
    elif is_number "$interval"; then
      if ! awk -v v="$interval" 'BEGIN { exit !(v > 0) }'; then
        echo "sysread: interval must be a positive number" >&2
        return 1
      fi
    else
      echo "sysread: interval must be a positive number" >&2
      return 1
    fi
    if [[ "$#" -gt 3 ]]; then
      usage
      return 1
    fi
  else
    usage
    return 1
  fi

  pick_gpu_source
  provider_cpu_info_once

  if [[ "$mode" == "once" ]]; then
    # Prime percentage functions, wait ~0.2 s, then report real deltas.
    provider_cpu_usage
    if [[ "$GPU_SOURCE" == "intel" ]]; then
      provider_gpu_intel
    fi
    sleep 0.2
    emit_reading
  else
    while true; do
      emit_reading
      sleep "$interval"
    done
  fi
}

main "$@"
